package main

import "core:fmt"
import "core:odin/ast"
import "core:odin/parser"
import "core:odin/tokenizer"
import "core:os"
import "core:path/filepath"
import "core:strings"

import sp "shared:odin-slang/slang"

Type_Spec :: struct {
	slang_name: string,
	odin_name:  string,
}

collect_type_specs :: proc() -> [dynamic]Type_Spec {
	src, err := os.read_entire_file("src/graphics/gpu_types.odin", context.temp_allocator)
	if err != nil do os.exit(1)
	file := ast.new(ast.File, tokenizer.Pos{}, tokenizer.Pos{})
	file.src = string(src)
	file.fullpath, _ = filepath.abs("src/graphics/gpu_types.odin", context.temp_allocator)
	p := parser.default_parser()
	if !parser.parse_file(&p, file) do os.exit(1)
	specs: [dynamic]Type_Spec
	for decl in file.decls {
		value, ok := decl.derived_stmt.(^ast.Value_Decl)
		if !ok || len(value.names) != 1 || len(value.values) != 1 do continue
		_, struct_ok := value.values[0].derived_expr.(^ast.Struct_Type)
		if !struct_ok do continue
		name, name_ok := value.names[0].derived.(^ast.Ident)
		if !name_ok do continue
		slang := name.name
		if strings.has_prefix(slang, "Gpu") do slang = slang[3:]
		append(&specs, Type_Spec{slang, name.name})
	}
	return specs
}

Target_Layout :: struct {
	name:    string,
	program: ^sp.ProgramLayout,
}

fail :: proc(message: string) -> ! {
	fmt.eprintln(message)
	os.exit(1)
}

check_diagnostics :: proc(blob: ^sp.IBlob) {
	if blob == nil do return
	defer blob->release()
	message := cstring(blob->getBufferPointer())
	if len(message) > 0 do fmt.eprintf("%s\n", message)
}

type_layout :: proc(target: Target_Layout, name: string) -> ^sp.TypeLayoutReflection {
	name_cstr := strings.clone_to_cstring(name, context.temp_allocator)
	t := sp.Reflection_FindTypeByName(target.program, name_cstr)
	if t == nil do fail(fmt.tprintf("Slang type not found: %s (%s)", name, target.name))
	layout := sp.Reflection_GetTypeLayout(target.program, t, .DEFAULT)
	if layout == nil do fail(fmt.tprintf("Slang layout not found: %s (%s)", name, target.name))
	return layout
}

main :: proc() {
	types := collect_type_specs()
	global: ^sp.IGlobalSession
	if sp.FAILED(sp.createGlobalSession(sp.API_VERSION, &global)) do fail("could not create Slang global session")
	defer global->release()

	spirv_options := [2]sp.CompilerOptionEntry {
		{name = .VulkanUseEntryPointName, value = {kind = .Int, intValue0 = 1}},
		{name = .GLSLForceScalarLayout, value = {kind = .Int, intValue0 = 1}},
	}
	targets := [2]sp.TargetDesc {
		{
			structureSize = size_of(sp.TargetDesc),
			format = .SPIRV,
			flags = {.GENERATE_SPIRV_DIRECTLY},
			profile = global->findProfile("spirv"),
			compilerOptionEntries = &spirv_options[0],
			compilerOptionEntryCount = len(spirv_options),
		},
		{structureSize = size_of(sp.TargetDesc), format = .METAL, profile = global->findProfile("metal")},
	}
	search_paths := [1]cstring{"shaders"}
	session_desc := sp.SessionDesc {
		structureSize           = size_of(sp.SessionDesc),
		targets                 = &targets[0],
		targetCount             = len(targets),
		defaultMatrixLayoutMode = .COLUMN_MAJOR,
		searchPaths             = &search_paths[0],
		searchPathCount         = len(search_paths),
	}
	session: ^sp.ISession
	if sp.FAILED(global->createSession(session_desc, &session)) do fail("could not create Slang session")
	defer session->release()

	diagnostics: ^sp.IBlob
	module := session->loadModule("types", &diagnostics)
	check_diagnostics(diagnostics)
	if module == nil do fail("could not load shaders/types.slang")
	defer module->release()

	target_layouts: [2]Target_Layout
	target_names := [2]string{"Vulkan scalar", "Metal"}
	for target_name, target_index in target_names {
		diagnostics = nil
		program := module->getLayout(target_index, &diagnostics)
		check_diagnostics(diagnostics)
		if program == nil do fail(fmt.tprintf("could not reflect %s target", target_name))
		target_layouts[target_index] = {target_name, program}
	}

	fmt.println("package graphics")
	fmt.println()
	fmt.println("// Generated by: ./tools/generate-layout-asserts.sh")
	fmt.println("// Slang's Vulkan scalar and Metal layouts must agree before assertions are emitted.")
	fmt.println("GPU_TYPES_GENERATING :: #config(GPU_TYPES_GENERATING, false)")
	fmt.println("when !GPU_TYPES_GENERATING {")
	for spec in types {
		vk := type_layout(target_layouts[0], spec.slang_name)
		metal := type_layout(target_layouts[1], spec.slang_name)
		vk_size := sp.ReflectionTypeLayout_GetSize(vk, .Uniform)
		metal_size := sp.ReflectionTypeLayout_GetSize(metal, .Uniform)
		if vk_size != metal_size {
			fail(fmt.tprintf("layout divergence: %s size is Vulkan=%d Metal=%d", spec.slang_name, vk_size, metal_size))
		}
		fmt.printf("#assert(size_of(%s) == %d)\n", spec.odin_name, vk_size)
	}

	fmt.println()
	for spec in types {
		vk := type_layout(target_layouts[0], spec.slang_name)
		metal := type_layout(target_layouts[1], spec.slang_name)
		field_count := sp.ReflectionTypeLayout_GetFieldCount(vk)
		if field_count != sp.ReflectionTypeLayout_GetFieldCount(metal) {
			fail(fmt.tprintf("layout divergence: %s field count differs", spec.slang_name))
		}
		for field_index in 0 ..< field_count {
			vk_field := sp.ReflectionTypeLayout_GetFieldByIndex(vk, field_index)
			metal_field := sp.ReflectionTypeLayout_GetFieldByIndex(metal, field_index)
			variable := sp.ReflectionVariableLayout_GetVariable(vk_field)
			field_name := sp.ReflectionVariable_GetName(variable)
			if string(field_name)[0] == '_' do continue
			vk_offset := sp.ReflectionVariableLayout_GetOffset(vk_field, .Uniform)
			metal_offset := sp.ReflectionVariableLayout_GetOffset(metal_field, .Uniform)
			if vk_offset != metal_offset {
				fail(
					fmt.tprintf(
						"layout divergence: %s.%s offset is Vulkan=%d Metal=%d",
						spec.slang_name,
						field_name,
						vk_offset,
						metal_offset,
					),
				)
			}
			fmt.printf("#assert(offset_of(%s, %s) == %d)\n", spec.odin_name, field_name, vk_offset)
		}
	}
	fmt.println("}")
}
